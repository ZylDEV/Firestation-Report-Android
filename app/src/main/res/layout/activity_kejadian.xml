<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9D9D9"
    tools:context=".kejadian">

    <TextView
        android:id="@+id/ataslayar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FFFFFF"
        android:layout_alignParentTop="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:textColor="#000000"
        android:text="@string/app_name2"
        android:textSize="25sp"
        android:layout_marginStart="110dp" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/logo3"
        android:layout_marginTop="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <ImageView
        android:id="@+id/penjelasan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ataslayar"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="25dp"
        android:src="@drawable/kejadian" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/penjelasan"
        android:layout_marginTop="15dp"
        android:layout_marginStart="30dp"
        android:layout_marginBottom="70dp"
        android:layout_centerHorizontal="true">
        <LinearLayout
            android:id="@+id/kejadian"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tampilan"
                android:layout_width="match_parent"
                android:layout_height="600dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/keterangan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="#000000"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:textSize="18sp"/>
        </LinearLayout>

    </ScrollView>


    <TextView
        android:id="@+id/bawahlayar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#FFF"
        android:layout_alignParentBottom="true" />

    <Button
        android:id="@+id/btnutama"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:backgroundTint="#000000"
        android:background="@drawable/home_app_logo_24dp_000000_fill0_wght400_grad0_opsz24"
        android:layout_marginStart="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnmomen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/newspaper_24dp_000000_fill0_wght400_grad0_opsz24"
        app:backgroundTint="#000000"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="15dp"/>

    <Button
        android:id="@+id/btnmenu"
        app:backgroundTint="#000000"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/account_circle_24dp_000000_fill0_wght400_grad0_opsz24"
        android:layout_marginEnd="60dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="15dp"/>

</RelativeLayout>
