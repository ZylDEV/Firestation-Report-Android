<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9D9D9"
    tools:context=".paduan">

    <TextView
        android:id="@+id/ataslayar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FFFFFF"
        android:layout_alignParentTop="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/app_name2"
        android:textColor="#000000"
        android:textSize="25sp"
        android:layout_marginStart="110dp" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/logo3"
        android:layout_marginTop="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp" />

    <ImageView
        android:id="@+id/penjelasan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="25dp"
        android:src="@drawable/penjelasan" />

    <TextView
        android:id="@+id/bawahlayar"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:background="#FFF"
        android:layout_below="@+id/penjelasan"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:layout_centerHorizontal="true"/>


    <TextView
        android:id="@+id/info1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/penjelasan"
        android:layout_marginTop="35dp"
        android:layout_marginStart="30dp"
        android:layout_centerHorizontal="true"
        android:textColor="#000000"
        android:text="@string/info1"
        android:textSize="16sp" />

    <ImageView
        android:layout_width="348dp"
        android:layout_height="400dp"
        android:layout_below="@+id/info1"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:src="@drawable/screenshot_2024_06_08_173017" />


</RelativeLayout>
